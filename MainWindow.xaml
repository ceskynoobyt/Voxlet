<Window x:Class="Voxlet.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Voxlet" Width="1200" Height="820" MinWidth="960" MinHeight="640" WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" Background="{DynamicResource Canvas}" Foreground="{DynamicResource PrimaryText}" FontFamily="Segoe UI">
  <Grid Margin="3">
    <Grid.Background><SolidColorBrush Color="#FF0A0A12"/></Grid.Background>
    <Grid x:Name="ThemeBackdrop" IsHitTestVisible="False"><Ellipse x:Name="AmbientGlowOne" Width="900" Height="760" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-260,-220,0" Fill="{DynamicResource AmbientGlowOne}"/><Ellipse x:Name="AmbientGlowTwo" Width="850" Height="720" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-250,0,0,-300" Fill="{DynamicResource AmbientGlowTwo}"/><Ellipse x:Name="AmbientGlowThree" Width="640" Height="580" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource AmbientGlowThree}"/></Grid>
    <Border Background="#B90C0D13" BorderBrush="#42FFFFFF" BorderThickness="1" CornerRadius="12" Margin="5"><Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#A30C0D13" BorderBrush="#25FFFFFF" BorderThickness="0,0,1,0" CornerRadius="12,0,0,12"><DockPanel Margin="12,16,12,12">
        <StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal" Margin="8,4,0,24"><Border Width="28" Height="28" CornerRadius="9" Background="#FF111111" Margin="0,0,9,0"><Path Data="M 4,11 H 8 L 11,18 L 15,7 L 19,18 L 22,11 H 26" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Border><TextBlock Text="VOXLET" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel>
          <Button x:Name="NavHome" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="Home"><StackPanel Orientation="Horizontal"><TextBlock Text="⌂" Width="25"/><TextBlock Text="Home"/></StackPanel></Button>
          <Button x:Name="NavInsights" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="Insights"><StackPanel Orientation="Horizontal"><TextBlock Text="▥" Width="25"/><TextBlock Text="Insights"/></StackPanel></Button>
          <Button x:Name="NavChat" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="Chat"><StackPanel Orientation="Horizontal"><TextBlock Text="▱" Width="25"/><TextBlock Text="Chat"/></StackPanel></Button>
          <Button x:Name="NavNotes" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="Notes"><StackPanel Orientation="Horizontal"><TextBlock Text="▤" Width="25"/><TextBlock Text="Notes"/></StackPanel></Button>
          <Button x:Name="NavUpload" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="Upload"><StackPanel Orientation="Horizontal"><TextBlock Text="↑" Width="25"/><TextBlock Text="Upload"/></StackPanel></Button>
          <Button x:Name="NavDictionary" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="Dictionary"><StackPanel Orientation="Horizontal"><TextBlock Text="▧" Width="25"/><TextBlock Text="Dictionary"/></StackPanel></Button>
          <Button x:Name="NavIntegrations" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="Integrations"><StackPanel Orientation="Horizontal"><TextBlock Text="▦" Width="25"/><TextBlock Text="Integrations"/></StackPanel></Button>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom"><Button x:Name="NavSettings" Style="{StaticResource NavButton}" Click="Settings_Click" Tag="Settings"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Width="25"/><TextBlock Text="Settings"/></StackPanel></Button><TextBlock Text="Voxlet Preview 0.4.12" FontSize="10" Foreground="{DynamicResource MutedText}" Margin="10,10,0,2"/></StackPanel>
      </DockPanel></Border>
      <Grid Grid.Column="1" Margin="16,0,0,0"><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="EngineLabel" Visibility="Collapsed"/>
        <Grid Grid.Row="0" Margin="6,0,14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="☰" Width="30" Height="30" Padding="0" Style="{StaticResource AppButton}" Click="ToggleSidebar_Click" Margin="0,0,8,0"/><TextBlock x:Name="PageTitle" Text="Home" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><Border Grid.Column="1" Width="340" Height="32" HorizontalAlignment="Center" CornerRadius="16" Background="#24FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1"><Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="⌕" Foreground="{DynamicResource MutedText}" FontSize="18" VerticalAlignment="Center"/><TextBox x:Name="SearchBox" Grid.Column="1" Text="Search notes and transcripts…" Foreground="{DynamicResource MutedText}" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" FontSize="12" GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus" KeyDown="SearchBox_KeyDown"/></Grid></Border><StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="＋  New note" Style="{StaticResource AppButton}" Padding="12,6" Click="NewNote_Click"/><Button Content="◉" Width="30" Height="30" Padding="0" Style="{StaticResource AppButton}" ToolTip="Local profile" Margin="7,0,0,0" Click="Settings_Click"/></StackPanel></Grid>
        <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" ScrollChanged="MainScroll_ScrollChanged" Margin="8,4,16,0"><StackPanel x:Name="PageHost"/></ScrollViewer>
        <TextBlock x:Name="StatusText" Grid.Row="2" Text="Ready" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="8,8,0,8"/>
      </Grid>
    </Grid></Border>
  </Grid>
</Window>
