<Application x:Class="Voxlet.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <Color x:Key="CanvasColor">#10101B</Color><Color x:Key="SidebarColor">#111522</Color><Color x:Key="PanelColor">#151A27</Color><Color x:Key="RaisedColor">#242B3E</Color><Color x:Key="StrokeColor">#707A96</Color><Color x:Key="TextColor">#F4F5FA</Color><Color x:Key="MutedColor">#B8BDCC</Color><Color x:Key="AccentColor">#FF3EC8</Color>
    <SolidColorBrush x:Key="GlassInnerFill" Color="#18292B3A"/><SolidColorBrush x:Key="GlassInnerEdge" Color="#45FFFFFF"/><LinearGradientBrush x:Key="GlassReflection" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#26FFFFFF" Offset="0"/><GradientStop Color="#08FFFFFF" Offset="0.3"/><GradientStop Color="#24FFFFFF" Offset="0.52"/><GradientStop Color="#05FFFFFF" Offset="0.72"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush><SolidColorBrush x:Key="Canvas" Color="{StaticResource CanvasColor}"/><SolidColorBrush x:Key="Sidebar" Color="{StaticResource SidebarColor}"/><SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}"/><SolidColorBrush x:Key="Raised" Color="{StaticResource RaisedColor}"/><SolidColorBrush x:Key="Stroke" Color="{StaticResource StrokeColor}"/><SolidColorBrush x:Key="PrimaryText" Color="{StaticResource TextColor}"/><SolidColorBrush x:Key="MutedText" Color="{StaticResource MutedColor}"/><SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
